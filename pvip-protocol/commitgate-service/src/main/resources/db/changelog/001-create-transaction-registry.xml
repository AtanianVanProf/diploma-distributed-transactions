<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-transaction-registry" author="commitgate-service">
        <createTable tableName="transaction_registry">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="transaction_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="expected_participants" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="received_responses" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="decision" type="VARCHAR(10)"/>
            <column name="decision_reason" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="decided_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="transaction_registry" indexName="idx_transaction_registry_status_created">
            <column name="status"/>
            <column name="created_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="transaction_registry"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
